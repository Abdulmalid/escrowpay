# EscrowPay Global — environment. Demo mode needs NONE of these set.
# Copy to .env.local and fill only the paths you want to go live.

# --- Financial provider: "demo" (default) or "blaaiz" ---
FINANCIAL_PROVIDER=demo

# --- Supabase (production data path; P1 wiring) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Blaaiz (all server-side; never NEXT_PUBLIC_) ---
BLAAIZ_ENV=dev
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
BLAAIZ_SCOPES=wallet:read collection:create virtual-account:create virtual-account:read payout:create swap:create fees:read currency:read webhook:write webhook:read
BLAAIZ_WEBHOOK_SIGNING_SECRET=

# --- AI Guardian (unset = deterministic heuristic fallback) ---
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
