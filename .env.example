# Blaaiz API Configuration
BLAAIZ_BASE_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=your_blaaiz_client_id_here
BLAAIZ_CLIENT_SECRET=your_blaaiz_client_secret_here
BLAAIZ_WEBHOOK_SIGNING_SECRET=blaaiz_whsec_hackathon_demo_key_9921
BLAAIZ_SIMULATION_MODE=true

# Next.js Public App Config
NEXT_PUBLIC_APP_NAME="EscrowPay Global"
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase Postgres (transaction pooler URL from the dashboard: Connect > Transaction pooler)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:6543/postgres
